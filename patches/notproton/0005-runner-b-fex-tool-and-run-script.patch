+# Both Steam tools use the game's one compatdata folder, whose pfx is where Steam Cloud maps
+# the game's saves, but an x86_64 and an aarch64 Wine cannot share a prefix. Switching tools
+# parks the other runner's prefix as pfx.<machine> and brings this runner's back (or lets
+# wineboot make one), so a game moves between runners with nothing lost or rebuilt.
+swap_prefix() {
+  parked="$STEAM_COMPAT_DATA_PATH/pfx.$have"
+  back="$STEAM_COMPAT_DATA_PATH/pfx.$want"
+  if [ -e "$parked" ] || [ -L "$parked" ] || [ -L "$WINEPREFIX" ]; then
+    echo "=== cannot park the $have prefix: pfx.$have already exists or pfx is a link ===" >> "$log" 2>&1 || true
+    return 1
+  fi
+  # Nothing may still run in the prefix being parked, and its wineserver is the other runner's,
+  # so this one cannot stop it: give a closing session the seconds its wineserver lingers.
+  ids=$(stat -f '%d-%i' "$WINEPREFIX" 2>/dev/null) || return 1
+  sdir=$(printf '/tmp/.wine-%s/server-%s' "$(id -u)" \
+    "$(printf '%s' "$ids" | awk -F- '{printf "%x-%x", $1, $2}')")
+  tries=0
+  while [ -d "$sdir" ] && lsof -t +D "$sdir" 2>/dev/null | grep -q .; do
+    tries=$((tries + 1))
+    if [ "$tries" -gt 15 ]; then
+      echo "=== the $have prefix is still in use, not parking it ===" >> "$log" 2>&1 || true
+      return 1
+    fi
+    sleep 1
+  done
+  mv "$WINEPREFIX" "$parked" 2>> "$log" || return 1
+  if [ -d "$back" ] && [ ! -L "$back" ]; then
+    if ! mv "$back" "$WINEPREFIX" 2>> "$log"; then
+      mv "$parked" "$WINEPREFIX" 2>> "$log" || true
+      return 1
+    fi
+    echo "=== parked the $have prefix as pfx.$have, restored pfx.$want ===" >> "$log" 2>&1 || true
+  else
+    mkdir -p "$WINEPREFIX"
+    echo "=== parked the $have prefix as pfx.$have, a new $want prefix follows ===" >> "$log" 2>&1 || true
+  fi
+  return 0
+}
