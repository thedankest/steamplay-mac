@@ -564,6 +565,30 @@ fi
 
 export WINEDEBUG="${WINEDEBUG:-err+all,fixme-all}"
 trap - EXIT
+# Per-game fixes, Proton style: notproton/fixes/<appid>.sh is sourced right before launch and
+# may only use the helpers below. Each helper is idempotent; set_env names are forwarded to the
+# game explicitly. edit_file takes a path under the prefix user's profile, one * allowed.
+fix_env=""
+fix_file="$HOME/Library/Application Support/notproton/fixes/$app_id.sh"
+# shellcheck disable=SC2329 # the helpers are called from the sourced fix file
+if [ "$verb" = waitforexitandrun ] && [ -r "$fix_file" ]; then
+  set_env() { export "$1=$2"; fix_env="$fix_env $1"; echo "fix: env $1=$2" >> "$log" 2>&1 || true; }
+  set_reg() { "$WINELOADER" reg add "$1" /v "$2" /t "$3" /d "$4" /f >> "$log" 2>&1 || true; }
+  dll_override() { set_reg 'HKCU\Software\Wine\DllOverrides' "$1" REG_SZ "$2"; }
+  set_winver() { set_reg "HKCU\\Software\\Wine\\AppDefaults\\$1" Version REG_SZ "$2"; }
+  edit_file() {
+    fix_base="$WINEPREFIX/drive_c/users/steamuser"
+    fix_cr=$(printf '\r')
+    find "$fix_base" -path "$fix_base/$1" -type f 2>/dev/null | while IFS= read -r f; do
+      # "key value" or "key=value" lines; CRLF and the separator are kept
+      sed -i '' -E "s/^($2)([ =])[^$fix_cr]*/\1\2$3/" "$f" && echo "fix: $f: $2 -> $3" >> "$log" 2>&1 || true
+    done
+  }
+  echo "=== fixes: $fix_file ===" >> "$log" 2>&1 || true
+  # shellcheck disable=SC1090 # per-game file chosen at run time
+  . "$fix_file" || echo "=== fixes: $fix_file failed ===" >> "$log" 2>&1 || true
+fi
+
 echo "launch_env=$launch_env" >> "$log" 2>&1 || true
 echo "=== launching ($verb): $WINELOADER $* ===" >> "$log" 2>&1 || true
 
@@ -833,6 +858,10 @@ for name in $(env | sed -nE 's/^(Steam[A-Za-z0-9]*|WINEDLLPATH_PREPEND|(CX_GRAPH
   # shellcheck disable=SC2154 # eval assigns value on the line above
   set -- --env "$name=$value" "$@"
 done
+for name in $fix_env $(env | sed -nE 's/^(CX_FWD_COMPAT_GL_CTX)=.*/\1/p'); do
+  eval "value=\$$name"
+  set -- --env "$name=$value" "$@"
+done
 set -- \
   --env CX_ROOT="$CX_ROOT" \
   --env CX_HOME="$CX_HOME" \
